# CHEAT CLIP — Environment Template
# ============================================================
# This app does NOT use a server-side Gemini API key.
# Users provide their own Gemini API key via the web interface at runtime.
#
# Get a free key at: https://aistudio.google.com/
# ============================================================

# Rotating Supadata API Keys for serverless YouTube transcript auto-fetching.
# Provide one or more comma-separated keys. The backend automatically rotates
# through them to distribute requests and handle rate limits/quota exhaustion.
# Get free keys (100 req/month each) at: https://supadata.ai/
SUPADATA_API_KEYS=key1,key2,key3

# Optional Proxy Configuration for last-resort fallback subtitle fetching & datacenter scraping.
# Used when YouTube blocks direct requests or when hosting on cloud/serverless providers.
# Supported formats: http://username:password@host:port or http://host:port
# PROXY_URL=http://user:pass@p.webshare.io:80
# WEBSHARE_PROXY=http://user-rotate:pass@p.webshare.io:80
